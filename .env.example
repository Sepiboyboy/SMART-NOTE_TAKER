# Copy to `.env` and fill in. Every setting can also be passed as an environment variable.

# "openai" for real transcription and summaries, or "mock" to run the whole pipeline offline.
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Models (optional). Speaker labels require a "-diarize" transcription model.
# TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
# SUMMARY_MODEL=gpt-5-mini

# Long recordings (optional)
# MAX_UPLOAD_MB=200
# MAX_AUDIO_MINUTES=180
# CHUNK_SECONDS=600
# AI_CONCURRENCY=3

# Summaries (optional)
# SUMMARY_SINGLE_PASS_TOKENS=24000   # longer transcripts are summarized section by section
# SUMMARY_SECTION_TOKENS=8000
# DROP_UNVERIFIED_ITEMS=false        # true: remove items whose quote is not in the transcript

# Logging and API (optional)
# LOG_LEVEL=INFO
# CORS_ORIGINS=["http://localhost:3000"]

# Only needed when running outside Docker Compose:
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# MONGO_URL=mongodb://localhost:27017
# STORAGE_DIR=./data/audio
